<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StopRunningApiOnBuild Condition="'$(StopRunningApiOnBuild)' == '' and '$(Configuration)' == 'Debug' and '$(ContinuousIntegrationBuild)' != 'true'">true</StopRunningApiOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.21">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\O2P.Application\O2P.Application.csproj" />
    <ProjectReference Include="..\O2P.Infrastructure.Metadata\O2P.Infrastructure.Metadata.csproj" />
    <ProjectReference Include="..\O2P.Infrastructure.Oracle\O2P.Infrastructure.Oracle.csproj" />
    <ProjectReference Include="..\O2P.Infrastructure.Postgres\O2P.Infrastructure.Postgres.csproj" />
  </ItemGroup>

  <!-- Stop any running Api before Debug build so bin DLLs are not locked (MSB3027). -->
  <Target Name="StopRunningApiBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(StopRunningApiOnBuild)' == 'true'">
    <Message Importance="high" Text="Stopping running O2P.Api processes so build can overwrite output DLLs..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='SilentlyContinue'; Get-Process -Name 'O2P.Api' | Stop-Process -Force; Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -match 'O2P\\.Api(\\.dll|\\.exe|\\\\O2P\\.Api)' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }; Start-Sleep -Milliseconds 400; exit 0&quot;"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>

</Project>
