{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "MetadataDb": "Host=localhost;Port=5432;Database=myappdb;Username=postgres;Password=postgres;"
  },
  "Concurrency": {
    "MaxOracleSessions": 8,
    "MaxChunkWorkers": 8,
    "ChunkTimeoutMinutes": 20
  }
}
