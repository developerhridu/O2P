{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "MetadataDb": "Host=localhost;Port=5432;Database=myappdb;Username=postgres;Password=postgres;"
  },
  "Concurrency": {
    "MaxOracleSessions": 8,
    "MaxChunkWorkers": 8
  },
  "Copying": {
    "RowsPerBatch": 200000,
    "RowsPerLobBatch": 25000,
    "StallMinutes": 10,
    "MaxBatchMinutes": 0,
    "MaxAttempts": 5,
    "MaxRowsPerSecond": 0,
    "InitialLobFetchSize": 262144
  }
}
